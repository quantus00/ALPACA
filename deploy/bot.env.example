# Copy to /etc/bot.env on the droplet and fill in real values, then:
#   sudo chmod 600 /etc/bot.env
# NEVER commit the filled-in version. Keys live here (or in the environment) only.

# ---- What to trade ----------------------------------------------------------
BOT_BROKER=coinbase
BOT_INSTRUMENT=btc_usd_spot     # btc_usd_spot (long/flat) | btc_nano_perp (long+short)
BOT_CONTRACT_SIZE=0.001         # BTC per order — start tiny

# ---- Safety switch ----------------------------------------------------------
# true  = DRY-RUN, simulate only (START HERE, for days)
# false = LIVE, real-money orders on Coinbase
BOT_DRY_RUN=true

# ---- FVG strategy knobs -----------------------------------------------------
FVG_TF=1m
FVG_RR=2.0                      # reward:risk multiple
FVG_BUFFER=0.0                  # stop buffer in price units (e.g. 5 = $5 beyond the gap)
FVG_MAX_HOLD=0                  # bars before a time-stop (0 = disabled)
FVG_MIN_GAP_FRAC=0.0            # ignore gaps smaller than this fraction of price (e.g. 0.0005)
BOT_POLL_SECONDS=60             # 1-minute loop
BOT_LOG_LEVEL=INFO

# ---- Coinbase keys (from your key store; rotate anything exposed) ------------
COINBASE_API_KEY=
COINBASE_API_SECRET=

# ---- Notifications (optional) ----------------------------------------------
NOTIFY_DISCORD_WEBHOOK=
NOTIFY_TELEGRAM_TOKEN=
NOTIFY_TELEGRAM_CHAT=
