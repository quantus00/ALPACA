# Copy to /root/icc-bot.env and edit. Read by the systemd service.
# Use ABSOLUTE paths here — systemd does not expand ~ or $HOME.

COINBASE_KEY_FILE=/root/cdp_api_key.json

ICC_BROKER=coinbase
ICC_VENUE=futures
ICC_SYMBOLS=BIT,GOL,NOL
ICC_HTF=1h
ICC_LTF=15m
ICC_TARGET_RR=3.0

# Risk guardrails (start conservative)
ICC_RISK_PCT=0.5
ICC_MAX_DAILY_LOSS_PCT=3.0
ICC_MAX_OPEN=1
ICC_MAX_TRADES_PER_DAY=2

# Session filter: false = trade 24/7 (crypto); true = only the NY window below.
ICC_SESSION_ENABLED=false
ICC_SESSION_START_UTC=13
ICC_SESSION_END_UTC=16

# --- SAFETY ---
# Leave as dry_run until you've watched it for a while. To go LIVE you must set
# BOTH lines below (real money; leverage magnifies losses):
ICC_MODE=dry_run
# ICC_MODE=live
# ICC_I_UNDERSTAND_LIVE_RISK=yes
