# Copy to the REPO ROOT as .env.saas (it is git-ignored) and fill in.
# Also create deploy/.env containing SAAS_DOMAIN=signals.example.com for Caddy.

SAAS_BRAND_NAME=Structure Signals
SAAS_BASE_URL=https://signals.example.com
SAAS_SECRET_KEY=                 # python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SAAS_DB_PATH=/app/data/saas.db
SAAS_ADMIN_EMAILS=you@example.com
SAAS_SECURE_COOKIES=true
SAAS_PRICE_LABEL=$49 / month
SAAS_TRIAL_DAYS=7

# Markets the worker analyses: btc_usd_spot (free Coinbase data),
# spy_options / mes_futures (need ALPACA_API_KEY/SECRET for SPY bars)
SAAS_INSTRUMENTS=btc_usd_spot
SAAS_POLL_SECONDS=300

# TradingView alerts -> POST https://DOMAIN/ingest/tradingview?instrument=mes_futures&key=THIS
SAAS_INGEST_SECRET=

# Stripe (Dashboard -> Developers). Webhook endpoint: https://DOMAIN/stripe/webhook with events
# checkout.session.completed, customer.subscription.created/updated/deleted
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Telegram bot used to send subscriber alerts (from @BotFather)
NOTIFY_TELEGRAM_TOKEN=
SAAS_TELEGRAM_BOT_USERNAME=

# Market data for SPY / MES
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_FEED=iex
