# ============================================================================
# Droplet environment file.
# Install to /etc/alpaca/alpaca.env  (root-owned, chmod 600 — NEVER commit it)
# systemd loads this via EnvironmentFile= in the unit files.
# ============================================================================

# ---- Claude Code auth on the droplet (pick ONE) ----------------------------
# Long-lived token from `claude setup-token` (best for headless/unattended):
CLAUDE_CODE_OAUTH_TOKEN=
# ...or Console/API billing instead:
#ANTHROPIC_API_KEY=

# ---- Alpaca (SPY 0DTE bot + options/equity data) ---------------------------
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ---- Coinbase (cb_trade.py + trend bot) ------------------------------------
COINBASE_API_KEY=
COINBASE_API_SECRET=

# ---- Webull OpenAPI (webull_openapi.py) ------------------------------------
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_REGION=us
WEBULL_ACCOUNT_ID=

# ---- Trend bot toggles -----------------------------------------------------
BOT_BROKER=coinbase
BOT_INSTRUMENT=btc_usd_spot
BOT_CONTRACT_SIZE=0.01
BOT_DRY_RUN=true
BOT_WEBHOOK_HOST=0.0.0.0
BOT_WEBHOOK_PORT=8080
BOT_LOG_LEVEL=INFO
