# ---- ICC trading bot configuration ----
# Copy to .env, fill in, and `set -a; source .env; set +a` before running icc-bot.

# Venue + safety
ICC_BROKER=coinbase          # coinbase | webull
ICC_VENUE=spot               # coinbase: spot | futures | perp
ICC_MODE=dry_run             # dry_run | paper | live   (start with dry_run!)
# ICC_I_UNDERSTAND_LIVE_RISK=yes   # REQUIRED to actually arm live trading

# What / how to trade
ICC_SYMBOLS=BTC-USD,SOL-USD  # coinbase pairs; for webull use e.g. QQQ,AAPL
ICC_HTF=1h
ICC_LTF=15m
ICC_TARGET_RR=3.0

# ---- Derivatives (ICC_VENUE=futures or perp) ----
# Contracts are whole numbers, so give each product its underlying-per-contract
# multiplier. USE YOUR ACCOUNT'S REAL PRODUCT IDS (confirm they exist/are enabled).
# Example (multipliers are placeholders — verify on Coinbase):
# ICC_SYMBOLS=BTC-PERP-INTX,BIT-28NOV26-CDE,GOLD-FUT
# ICC_CONTRACT_SPECS=BTC-PERP-INTX=0.01,BIT-28NOV26-CDE=0.01,GOLD-FUT=1.0
# ICC_LEVERAGE=2               # blank = venue default
# ICC_MARGIN_TYPE=CROSS        # CROSS | ISOLATED
# COINBASE_PORTFOLIO_UUID=...  # REQUIRED for perp (INTX) venue

# Risk guardrails
ICC_RISK_PCT=1.0
ICC_MAX_DAILY_LOSS_PCT=3.0
ICC_MAX_OPEN=1
ICC_MAX_TRADES_PER_DAY=3
ICC_MAX_POSITION_PCT=25.0

# Session window (UTC). Default ~NY open. Set ICC_SESSION_ENABLED=false for 24/7 crypto.
ICC_SESSION_ENABLED=true
ICC_SESSION_START_UTC=13
ICC_SESSION_END_UTC=16

# ---- Credentials (set only the venue you use) ----
# Coinbase Developer Platform API key:
# COINBASE_API_KEY=organizations/xxx/apiKeys/yyy
# COINBASE_API_SECRET=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n

# Webull:
# WEBULL_EMAIL=you@example.com
# WEBULL_PASSWORD=your-password
# WEBULL_TRADE_PIN=123456
