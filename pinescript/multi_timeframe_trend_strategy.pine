//@version=5
// =============================================================================
// Multi-Timeframe Trend Structure — BACKTEST STRATEGY (TradingView only)
// -----------------------------------------------------------------------------
// Backtesting is done here, in TradingView's Strategy Tester. This mirrors the
// indicator's logic but uses strategy.entry/close so you can measure the edge:
//   * 4H trend from market structure (HH/HL = UP, LH/LL = DOWN; both legs must
//     break to flip).
//   * Enter long/short only when 5m, 15m, 30m and 1H all align with the new 4H
//     trend.
//   * Exit when the 4H trend flips against the position.
// Run it on the chart timeframe you want signals evaluated on (e.g. 5m) so the
// alignment timeframes are all >= chart resolution.
// =============================================================================
strategy("MTF Trend Structure — Backtest", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     initial_capital=10000, commission_type=strategy.commission.percent,
     commission_value=0.05, pyramiding=0, calc_on_every_tick=false,
     process_orders_on_close=true)

// ----------------------------------------------------------------------------- Inputs
grpStruct = "Market Structure"
pivotLen  = input.int(5, "Pivot lookback (bars each side)", minval=1, group=grpStruct)
trendTF   = input.timeframe("240", "Trend timeframe", group=grpStruct)

grpAlign  = "Entry Alignment Timeframes"
tf1 = input.timeframe("5",  "Alignment TF 1", group=grpAlign)
tf2 = input.timeframe("15", "Alignment TF 2", group=grpAlign)
tf3 = input.timeframe("30", "Alignment TF 3", group=grpAlign)
tf4 = input.timeframe("60", "Alignment TF 4", group=grpAlign)

grpTest   = "Backtest"
allowLong  = input.bool(true,  "Allow long trades",  group=grpTest)
allowShort = input.bool(true,  "Allow short trades", group=grpTest)
useDateFilter = input.bool(false, "Filter by date range", group=grpTest)
startDate = input.time(timestamp("2023-01-01 00:00"), "Start", group=grpTest)
endDate   = input.time(timestamp("2026-12-31 00:00"), "End",   group=grpTest)
useStop   = input.bool(false, "Use stop-loss (structure low/high)", group=grpTest)

// ----------------------------------------------------------------------------- Structure engine
f_trend_state() =>
    ph = ta.pivothigh(pivotLen, pivotLen)
    pl = ta.pivotlow(pivotLen, pivotLen)
    var float lastPH = na, var float prevPH = na
    var float lastPL = na, var float prevPL = na
    var int   state  = 0
    if not na(ph)
        prevPH := lastPH, lastPH := ph
    if not na(pl)
        prevPL := lastPL, lastPL := pl
    hh = not na(lastPH) and not na(prevPH) and lastPH > prevPH
    lh = not na(lastPH) and not na(prevPH) and lastPH < prevPH
    hl = not na(lastPL) and not na(prevPL) and lastPL > prevPL
    ll = not na(lastPL) and not na(prevPL) and lastPL < prevPL
    if hh and hl and state != 1
        state := 1
    if lh and ll and state != -1
        state := -1
    [state, lastPL, lastPH]

[htfState, _hLo, _hHi] = request.security(syminfo.tickerid, trendTF, f_trend_state(),
     lookahead=barmerge.lookahead_off)

f_state_only() =>
    [s, _a, _b] = f_trend_state()
    s
s1 = request.security(syminfo.tickerid, tf1, f_state_only(), lookahead=barmerge.lookahead_off)
s2 = request.security(syminfo.tickerid, tf2, f_state_only(), lookahead=barmerge.lookahead_off)
s3 = request.security(syminfo.tickerid, tf3, f_state_only(), lookahead=barmerge.lookahead_off)
s4 = request.security(syminfo.tickerid, tf4, f_state_only(), lookahead=barmerge.lookahead_off)

// structure stop levels from the trend timeframe swings
htfSwingLow  = request.security(syminfo.tickerid, trendTF, ta.valuewhen(not na(ta.pivotlow(pivotLen, pivotLen)),  ta.pivotlow(pivotLen, pivotLen),  0), lookahead=barmerge.lookahead_off)
htfSwingHigh = request.security(syminfo.tickerid, trendTF, ta.valuewhen(not na(ta.pivothigh(pivotLen, pivotLen)), ta.pivothigh(pivotLen, pivotLen), 0), lookahead=barmerge.lookahead_off)

// ----------------------------------------------------------------------------- Alignment
allUp   = htfState == 1  and s1 == 1  and s2 == 1  and s3 == 1  and s4 == 1
allDown = htfState == -1 and s1 == -1 and s2 == -1 and s3 == -1 and s4 == -1

inWindow = not useDateFilter or (time >= startDate and time <= endDate)

// ----------------------------------------------------------------------------- Orders
longSig  = allowLong  and allUp   and inWindow
shortSig = allowShort and allDown and inWindow

if longSig and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)
    if useStop and not na(htfSwingLow)
        strategy.exit("Long-SL", "Long", stop=htfSwingLow)

if shortSig and strategy.position_size >= 0
    strategy.entry("Short", strategy.short)
    if useStop and not na(htfSwingHigh)
        strategy.exit("Short-SL", "Short", stop=htfSwingHigh)

// Exit when the 4H trend flips against the open position.
if strategy.position_size > 0 and htfState == -1
    strategy.close("Long", comment="4H DOWN")
if strategy.position_size < 0 and htfState == 1
    strategy.close("Short", comment="4H UP")

// ----------------------------------------------------------------------------- Visuals
trendTxt = htfState == 1 ? "UPTREND" : htfState == -1 ? "DOWNTREND" : "NEUTRAL"
trendCol = htfState == 1 ? color.green : htfState == -1 ? color.red : color.gray
bgcolor(htfState == 1 ? color.new(color.green, 92) : htfState == -1 ? color.new(color.red, 92) : na)
var table info = table.new(position.top_right, 1, 2, border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "4H TREND", text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(info, 0, 1, trendTxt, text_color=color.white, bgcolor=color.new(trendCol, 0))
