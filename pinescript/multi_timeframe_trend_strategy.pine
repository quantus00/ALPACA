//@version=5
// =============================================================================
// Multi-Timeframe Trend Structure — BACKTEST STRATEGY (TradingView only)
// -----------------------------------------------------------------------------
// This is a strategy() script, so results appear in the Strategy Tester tab.
//   * 4H trend from market structure (HH/HL = UP, LH/LL = DOWN; both legs must
//     break to flip).
//   * Enter long/short only when 5m, 15m, 30m and 1H all align with the 4H
//     trend (toggle "Require alignment" off to trade every 4H flip instead).
//   * Exit when the 4H trend flips against the position (optional structure SL).
//
// PER-TRADE US DOLLARS:
//   * Each trade uses a fixed USD notional ("Order size (USD)"), so position
//     size scales with price and results read in real dollars.
//   * A "$" label is printed on the chart at every trade's exit showing that
//     trade's realized profit/loss in USD.
//   * A summary table (bottom-right) shows net $ P&L, win rate and trade count.
//   * The Strategy Tester -> List of Trades tab is the full per-trade ledger.
//
// TIP: run on 15m or 1H so the alignment timeframes are >= chart resolution.
// =============================================================================
strategy("MTF Trend Structure — Backtest", overlay=true,
     default_qty_type=strategy.fixed, default_qty_value=1,
     initial_capital=10000, commission_type=strategy.commission.percent,
     commission_value=0.05, pyramiding=0, calc_on_every_tick=false,
     process_orders_on_close=true, max_labels_count=500)

// ----------------------------------------------------------------------------- Inputs
grpStruct = "Market Structure"
pivotLen  = input.int(5, "Pivot lookback (bars each side)", minval=1, group=grpStruct)
trendTF   = input.timeframe("240", "Trend timeframe", group=grpStruct)

grpAlign  = "Entries"
requireAlign = input.bool(true, "Require 5m/15m/30m/1H alignment", group=grpAlign,
     tooltip="Off = enter on every confirmed 4H trend flip (more trades to inspect).")
tf1 = input.timeframe("5",  "Align TF 1", group=grpAlign)
tf2 = input.timeframe("15", "Align TF 2", group=grpAlign)
tf3 = input.timeframe("30", "Align TF 3", group=grpAlign)
tf4 = input.timeframe("60", "Align TF 4", group=grpAlign)
allowLong  = input.bool(true, "Allow longs",  group=grpAlign)
allowShort = input.bool(true, "Allow shorts", group=grpAlign)

grpTest   = "Backtest"
orderUsd  = input.float(10000, "Order size (USD notional per trade)", minval=1, group=grpTest,
     tooltip="Dollar value traded per entry. Position size = this / price.")
showPnl   = input.bool(true, "Label each trade's $ P&L on chart", group=grpTest)
useStop   = input.bool(false, "Structure stop-loss", group=grpTest)
stopLook  = input.int(20, "Stop lookback (bars)", minval=2, group=grpTest)
useDates  = input.bool(false, "Filter by date range", group=grpTest)
startD    = input.time(timestamp("2020-01-01 00:00"), "Start", group=grpTest)
endD      = input.time(timestamp("2027-01-01 00:00"), "End",   group=grpTest)

// ----------------------------------------------------------------------------- Structure engine
f_state() =>
    ph = ta.pivothigh(pivotLen, pivotLen)
    pl = ta.pivotlow(pivotLen, pivotLen)
    var float lph = na
    var float pph = na
    var float lpl = na
    var float ppl = na
    var int   st  = 0
    if not na(ph)
        pph := lph
        lph := ph
    if not na(pl)
        ppl := lpl
        lpl := pl
    hh = not na(lph) and not na(pph) and lph > pph
    lh = not na(lph) and not na(pph) and lph < pph
    hl = not na(lpl) and not na(ppl) and lpl > ppl
    ll = not na(lpl) and not na(ppl) and lpl < ppl
    if hh and hl and st != 1
        st := 1
    if lh and ll and st != -1
        st := -1
    st

htf = request.security(syminfo.tickerid, trendTF, f_state(), lookahead=barmerge.lookahead_off)
a1  = request.security(syminfo.tickerid, tf1, f_state(), lookahead=barmerge.lookahead_off)
a2  = request.security(syminfo.tickerid, tf2, f_state(), lookahead=barmerge.lookahead_off)
a3  = request.security(syminfo.tickerid, tf3, f_state(), lookahead=barmerge.lookahead_off)
a4  = request.security(syminfo.tickerid, tf4, f_state(), lookahead=barmerge.lookahead_off)

// ----------------------------------------------------------------------------- Alignment
alignUp   = not requireAlign or (a1 == 1  and a2 == 1  and a3 == 1  and a4 == 1)
alignDown = not requireAlign or (a1 == -1 and a2 == -1 and a3 == -1 and a4 == -1)

longOK  = allowLong  and htf == 1  and alignUp
shortOK = allowShort and htf == -1 and alignDown
inWin   = not useDates or (time >= startD and time <= endD)

// USD-notional position size for this bar.
qty = orderUsd / close

// ----------------------------------------------------------------------------- Orders
if inWin and longOK and strategy.position_size <= 0
    strategy.entry("Long", strategy.long, qty=qty)
    if useStop
        strategy.exit("Long-SL", "Long", stop=ta.lowest(low, stopLook))

if inWin and shortOK and strategy.position_size >= 0
    strategy.entry("Short", strategy.short, qty=qty)
    if useStop
        strategy.exit("Short-SL", "Short", stop=ta.highest(high, stopLook))

// Exit when the 4H trend flips against the open position.
if strategy.position_size > 0 and htf == -1
    strategy.close("Long", comment="4H DOWN")
if strategy.position_size < 0 and htf == 1
    strategy.close("Short", comment="4H UP")

// ----------------------------------------------------------------------------- Per-trade $ P&L labels
var int _seen = 0
if showPnl and strategy.closedtrades > _seen
    for i = _seen to strategy.closedtrades - 1
        p  = strategy.closedtrades.profit(i)          // realized profit in USD
        xb = strategy.closedtrades.exit_bar_index(i)
        xp = strategy.closedtrades.exit_price(i)
        col = p >= 0 ? color.new(color.green, 0) : color.new(color.red, 0)
        label.new(xb, xp, "$" + str.tostring(p, "#.##"),
             style=p >= 0 ? label.style_label_up : label.style_label_down,
             color=col, textcolor=color.white, size=size.small)
    _seen := strategy.closedtrades

// ----------------------------------------------------------------------------- Summary + trend tables
trendTxt = htf == 1 ? "UPTREND" : htf == -1 ? "DOWNTREND" : "NEUTRAL"
trendCol = htf == 1 ? color.green : htf == -1 ? color.red : color.gray
bgcolor(htf == 1 ? color.new(color.green, 90) : htf == -1 ? color.new(color.red, 90) : na)

var table info = table.new(position.top_right, 1, 2, border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "4H TREND", text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(info, 0, 1, trendTxt, text_color=color.white, bgcolor=color.new(trendCol, 0))

var table sum = table.new(position.bottom_right, 2, 5, border_width=1)
if barstate.islast
    n     = strategy.closedtrades
    wins  = strategy.wintrades
    wr    = n > 0 ? wins / n * 100 : 0.0
    net   = strategy.netprofit
    avg   = n > 0 ? net / n : 0.0
    pf    = strategy.grossloss != 0 ? strategy.grossprofit / strategy.grossloss : na
    netc  = net >= 0 ? color.new(color.green, 0) : color.new(color.red, 0)
    table.cell(sum, 0, 0, "Net P&L",    text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(sum, 1, 0, "$" + str.tostring(net, "#.##"), text_color=color.white, bgcolor=netc)
    table.cell(sum, 0, 1, "Avg / trade", text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(sum, 1, 1, "$" + str.tostring(avg, "#.##"), text_color=color.white, bgcolor=color.new(color.black, 40))
    table.cell(sum, 0, 2, "Trades",     text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(sum, 1, 2, str.tostring(n), text_color=color.white, bgcolor=color.new(color.black, 40))
    table.cell(sum, 0, 3, "Win rate",   text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(sum, 1, 3, str.tostring(wr, "#.#") + "%", text_color=color.white, bgcolor=color.new(color.black, 40))
    table.cell(sum, 0, 4, "Profit factor", text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(sum, 1, 4, na(pf) ? "-" : str.tostring(pf, "#.##"), text_color=color.white, bgcolor=color.new(color.black, 40))
