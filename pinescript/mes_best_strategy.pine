//@version=5
// =============================================================================
// MES BEST STRATEGY (hybrid) — Open + Trend + Pullback   [TradingView backtest]
// -----------------------------------------------------------------------------
// Chosen from real MESZ6 backtests (see backtest/results.md). Two modes in one:
//
//   CORE (default, Scale-in mode OFF):
//     * 1 contract, +30 / -10 pt bracket.
//     * Most robust in testing: small drawdowns, consistent, positive/breakeven
//       across samples.
//
//   SCALE-IN (toggle ON):
//     * Enter 1 contract. If price runs +15 pt in favor, ADD (default 7 -> 8
//       total). Then manage the whole position with a +60 / -20 pt bracket from
//       the blended average, PLUS a trend-flip exit (close if the 4H trend flips
//       against the position).
//     * Higher returns but much larger swings — size it down (add 3) if needed.
//
// ENTRIES (both modes):
//   * 09:30 ET open with the confirmed 4H trend (UP->long, DOWN->short); only on
//     timeframes whose bars align to 09:30 (M5/M15/M30).
//   * After a 4H trend change: WAIT, then re-enter on the pullback (price pulls
//     back against the new trend, then resumes). RTH only.
//
// 4H trend = market structure (HH/HL = UP, LH/LL = DOWN; both legs must break).
// MES = $5/point. Run on 5m/15m for the 09:30 entry; the scale-in shines on the
// trending days.
// =============================================================================
strategy("MES Best Strategy (hybrid)", overlay=true,
     default_qty_type=strategy.fixed, default_qty_value=1,
     initial_capital=10000, commission_type=strategy.commission.cash_per_contract,
     commission_value=0.62, pyramiding=20, calc_on_every_tick=false,
     process_orders_on_close=true, max_labels_count=500)

// ----------------------------------------------------------------------------- Inputs
gS = "Trend / Structure"
pivotLen = input.int(5, "Pivot lookback", minval=1, group=gS)
trendTF  = input.timeframe("240", "Trend timeframe", group=gS)

gE = "Entries"
useOpen  = input.bool(true, "09:30 ET open entry with trend", group=gE)
usePB    = input.bool(true, "Pullback re-entry after trend change", group=gE)
openSess = input.session("0930-1600", "Regular session (ET)", group=gE)
tz       = input.string("America/New_York", "Timezone", group=gE)

gC = "CORE mode (scale-in OFF)"
coreQty  = input.int(1, "Core contracts", minval=1, group=gC)
coreTP   = input.float(30, "Core take-profit (pts)", step=0.25, group=gC)
coreSL   = input.float(10, "Core stop-loss (pts)", step=0.25, group=gC)

gX = "SCALE-IN mode"
scaleOn  = input.bool(false, "Enable scale-in mode", group=gX,
     tooltip="OFF = steady 1-contract 30/10. ON = add on strength, wider bracket, flip exit.")
addPts   = input.float(15, "Add trigger (pts in favor)", step=0.25, group=gX)
addQty   = input.int(7, "Contracts to add", minval=1, group=gX,
     tooltip="7 -> 8 total (aggressive). Try 3 for ~half the drawdown.")
initSL   = input.float(10, "Pre-add stop (pts)", step=0.25, group=gX)
scaleTP  = input.float(60, "Post-add take-profit (pts)", step=0.25, group=gX)
scaleSL  = input.float(20, "Post-add stop (pts)", step=0.25, group=gX)
flipExit = input.bool(true, "Trend-flip exit (scale mode)", group=gX)

gR = "Display"
showPnl  = input.bool(true, "Label each trade's $ P&L", group=gR)

// ----------------------------------------------------------------------------- Structure engine
f_state() =>
    ph = ta.pivothigh(pivotLen, pivotLen)
    pl = ta.pivotlow(pivotLen, pivotLen)
    var float lph = na
    var float pph = na
    var float lpl = na
    var float ppl = na
    var int   st  = 0
    if not na(ph)
        pph := lph
        lph := ph
    if not na(pl)
        ppl := lpl
        lpl := pl
    hh = not na(lph) and not na(pph) and lph > pph
    lh = not na(lph) and not na(pph) and lph < pph
    hl = not na(lpl) and not na(ppl) and lpl > ppl
    ll = not na(lpl) and not na(ppl) and lpl < ppl
    if hh and hl and st != 1
        st := 1
    if lh and ll and st != -1
        st := -1
    st
htf = request.security(syminfo.tickerid, trendTF, f_state(), lookahead=barmerge.lookahead_off)

// ----------------------------------------------------------------------------- Session + pullback
inRTH       = not na(time(timeframe.period, openSess, tz))
firstBarRTH = inRTH and not inRTH[1]
isOpenBar   = hour(time, tz) == 9 and minute(time, tz) == 30

flipUp   = htf == 1  and htf[1] != 1
flipDown = htf == -1 and htf[1] != -1
var int  pbDir  = 0
var bool pulled = false
if flipUp
    pbDir := 1
    pulled := false
if flipDown
    pbDir := -1
    pulled := false
pbLong  = false
pbShort = false
if pbDir == 1
    pulled := pulled or (low < low[1])
    if pulled and close > high[1]
        pbLong := true
        pbDir  := 0
        pulled := false
if pbDir == -1
    pulled := pulled or (high > high[1])
    if pulled and close < low[1]
        pbShort := true
        pbDir  := 0
        pulled := false

// ----------------------------------------------------------------------------- Entries
flat = strategy.position_size == 0
var float entryPx = na
var int   entryDir = 0
if flat
    entryPx := na
    entryDir := 0

canOpen = useOpen and isOpenBar and inRTH
canPB   = usePB and inRTH

if flat and (canOpen or canPB)
    dir = 0
    if canOpen and htf != 0
        dir := htf
    else if canPB and pbLong
        dir := 1
    else if canPB and pbShort
        dir := -1
    if dir != 0
        strategy.entry("MES", dir == 1 ? strategy.long : strategy.short, qty=coreQty)
        entryPx := close
        entryDir := dir
        pbDir := 0
        pulled := false

// capture the real base fill on the first in-position bar
if not flat and na(entryPx)
    entryPx := strategy.position_avg_price
    entryDir := strategy.position_size > 0 ? 1 : -1

// ----------------------------------------------------------------------------- Scale-in add order
added = math.abs(strategy.position_size) > coreQty
if scaleOn and not flat and not added and not na(entryPx)
    trig = entryDir == 1 ? entryPx + addPts : entryPx - addPts
    strategy.order("Add", entryDir == 1 ? strategy.long : strategy.short,
         qty=addQty, stop=trig)
if flat or added
    strategy.cancel("Add")

// ----------------------------------------------------------------------------- Exits
if not flat
    dir = entryDir
    avg = strategy.position_avg_price
    if not scaleOn
        tp = dir == 1 ? avg + coreTP : avg - coreTP
        sl = dir == 1 ? avg - coreSL : avg + coreSL
        strategy.exit("X", stop=sl, limit=tp)
    else if not added
        // pre-add: only the initial stop (waiting to add or stop out)
        sl = dir == 1 ? entryPx - initSL : entryPx + initSL
        strategy.exit("X", stop=sl)
    else
        tp = dir == 1 ? avg + scaleTP : avg - scaleTP
        sl = dir == 1 ? avg - scaleSL : avg + scaleSL
        strategy.exit("X", stop=sl, limit=tp)
    // trend-flip exit (scale mode)
    if scaleOn and flipExit and ((dir == 1 and htf == -1) or (dir == -1 and htf == 1))
        strategy.close_all(comment="flip")

// ----------------------------------------------------------------------------- Per-trade $ P&L labels
var int _seen = 0
if showPnl and strategy.closedtrades > _seen
    for i = _seen to strategy.closedtrades - 1
        p  = strategy.closedtrades.profit(i)
        xb = strategy.closedtrades.exit_bar_index(i)
        xp = strategy.closedtrades.exit_price(i)
        cc = p >= 0 ? color.new(color.green, 0) : color.new(color.red, 0)
        label.new(xb, xp, "$" + str.tostring(p, "#.##"),
             style=p >= 0 ? label.style_label_up : label.style_label_down,
             color=cc, textcolor=color.white, size=size.small)
    _seen := strategy.closedtrades

// ----------------------------------------------------------------------------- Visuals + summary
trendTxt = htf == 1 ? "UPTREND" : htf == -1 ? "DOWNTREND" : "NEUTRAL"
trendCol = htf == 1 ? color.green : htf == -1 ? color.red : color.gray
bgcolor(inRTH ? na : color.new(color.gray, 94))
plotshape(firstBarRTH, title="09:30", style=shape.circle, location=location.bottom,
     color=color.new(color.blue, 45), size=size.tiny)

var table t = table.new(position.top_right, 2, 6, border_width=1)
if barstate.islast
    n = strategy.closedtrades
    wr = n > 0 ? strategy.wintrades / n * 100 : 0.0
    net = strategy.netprofit
    pf = strategy.grossloss != 0 ? strategy.grossprofit / strategy.grossloss : na
    hdr = color.new(color.black, 20)
    cel = color.new(color.black, 40)
    mode = scaleOn ? "SCALE-IN" : "CORE"
    table.cell(t, 0, 0, "MODE", text_color=color.white, bgcolor=hdr)
    table.cell(t, 1, 0, mode, text_color=color.white, bgcolor=cel)
    table.cell(t, 0, 1, "4H TREND", text_color=color.white, bgcolor=hdr)
    table.cell(t, 1, 1, trendTxt, text_color=color.white, bgcolor=color.new(trendCol, 0))
    table.cell(t, 0, 2, "Net P&L", text_color=color.white, bgcolor=hdr)
    table.cell(t, 1, 2, "$" + str.tostring(net, "#.##"), text_color=color.white, bgcolor=net >= 0 ? color.new(color.green, 0) : color.new(color.red, 0))
    table.cell(t, 0, 3, "Trades", text_color=color.white, bgcolor=hdr)
    table.cell(t, 1, 3, str.tostring(n), text_color=color.white, bgcolor=cel)
    table.cell(t, 0, 4, "Win%", text_color=color.white, bgcolor=hdr)
    table.cell(t, 1, 4, str.tostring(wr, "#.#") + "%", text_color=color.white, bgcolor=cel)
    table.cell(t, 0, 5, "Profit factor", text_color=color.white, bgcolor=hdr)
    table.cell(t, 1, 5, na(pf) ? "-" : str.tostring(pf, "#.##"), text_color=color.white, bgcolor=cel)
