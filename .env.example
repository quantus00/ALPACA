# Alpaca API credentials — generate at https://app.alpaca.markets
# Use PAPER keys unless you intend to trade a funded live account.
ALPACA_API_KEY_ID=your-key-id
ALPACA_API_SECRET_KEY=your-secret-key

# Trading environment. "true" (default) = paper endpoint; "false" = live.
ALPACA_PAPER=true

# Optional endpoint overrides (defaults are correct for most users).
# ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
# ALPACA_DATA_BASE_URL=https://data.alpaca.markets
