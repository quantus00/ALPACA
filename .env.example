# ============================================================================
# Multi-timeframe trend bot — configuration. Copy to .env and fill in.
# ============================================================================

# ---- Primary toggles -------------------------------------------------------
BOT_BROKER=coinbase             # coinbase | alpaca | tradovate | webull
BOT_INSTRUMENT=btc_usd_spot     # btc_usd_spot | btc_nano_perp | spy_options | mes_futures
BOT_CONTRACT_SIZE=0.01          # BTC qty, option contracts, or futures contracts

# ---- Strategy --------------------------------------------------------------
BOT_PIVOT_LOOKBACK=5
BOT_TREND_TF=4h
BOT_ALIGN_TFS=5m,15m,30m,1h
BOT_OPTION_DTE=0                # target days-to-expiry for options
BOT_OPTION_DELTA=0.40           # target option delta

# ---- Prop-firm challenge guard (trailing-drawdown evaluation) --------------
# When enabled, every entry is gated by the risk guard: profit target, daily
# loss cap, trailing drawdown, and flat-by-5pm / no-overnight session rules.
BOT_CHALLENGE_ENABLED=false     # true = enforce the challenge rules on entries
BOT_CHALLENGE_START=50000       # account starting balance ($)
BOT_CHALLENGE_TARGET=1500       # profit target = pass condition ($)
BOT_CHALLENGE_DAILY_LOSS=500    # daily loss limit ($)
BOT_CHALLENGE_TRAILING_DD=1000  # trailing drawdown ($)
BOT_CHALLENGE_TRAILING_MODE=intraday   # intraday (equity high-water) | eod (closing balance)
BOT_CHALLENGE_STOP_POINTS=5     # protective stop in points (0 = use the ORB range stop)

# ---- Opening Range Breakout (ORB) strategy ---------------------------------
BOT_ORB_MINUTES=15              # opening-range length (first N minutes of RTH)
BOT_ORB_TARGET_R=2             # profit target as a multiple of risk (0 = hold to EOD)
BOT_ORB_BUFFER_TICKS=1         # breakout must clear the range edge by this many ticks
BOT_ORB_TICK_SIZE=0.25         # instrument tick size (MES/ES = 0.25)
BOT_ORB_MAX_TRADES=1           # max ORB entries per day
BOT_ORB_MIN_POINTS=0           # skip the day if the opening range is tighter than this
BOT_ORB_MAX_POINTS=1e12        # skip the day if the opening range is wider than this

# ---- Runtime ---------------------------------------------------------------
BOT_DRY_RUN=true                # true = simulate, never send real orders
BOT_POLL_SECONDS=60
BOT_WEBHOOK_HOST=0.0.0.0
BOT_WEBHOOK_PORT=8080
BOT_WEBHOOK_SECRET=             # optional shared secret for TradingView alerts
BOT_LOG_LEVEL=INFO

# ---- Dashboard "Open trading windows" link (served at / ) -------------------
# The button on the dashboard opens these two URLs as two SEPARATE windows.
BOT_WINDOW_1_URL=https://www.tradingview.com/chart/
BOT_WINDOW_2_URL=https://www.coinbase.com/advanced-trade/spot/BTC-USD
BOT_WINDOW_1_TITLE=Chart
BOT_WINDOW_2_TITLE=Broker

# ---- Notifications (optional) ----------------------------------------------
NOTIFY_DISCORD_WEBHOOK=
NOTIFY_TELEGRAM_TOKEN=
NOTIFY_TELEGRAM_CHAT=

# ---- Coinbase (BTC/USD spot + nano perp) -----------------------------------
COINBASE_API_KEY=
COINBASE_API_SECRET=

# ---- Alpaca (SPY options + equity data) ------------------------------------
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex

# ---- Tradovate (MES futures) -----------------------------------------------
TRADOVATE_ENV=demo              # demo | live
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_APP_SECRET=
TRADOVATE_ACCOUNT_SPEC=
TRADOVATE_ACCOUNT_ID=
TRADOVATE_MES_SYMBOL=           # optional, e.g. MESU5; else auto-resolved

# ---- Webull (SPY options) --------------------------------------------------
WEBULL_EMAIL=
WEBULL_PASSWORD=
WEBULL_TRADE_PIN=
WEBULL_DEVICE_ID=
